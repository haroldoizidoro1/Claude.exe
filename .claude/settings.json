{
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": { "source": "github", "repo": "thedotmack/claude-mem" }
    },
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    },
    "one-skill-to-rule-them-all": {
      "source": { "source": "github", "repo": "rebelytics/one-skill-to-rule-them-all" }
    },
    "caveman": {
      "source": { "source": "github", "repo": "JuliusBrussee/caveman" }
    }
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "claude-code-setup@claude-plugins-official": true,
    "task-observer@one-skill-to-rule-them-all": true,
    "caveman@caveman": true
  },
  "permissions": {
    "allow": [
      "Bash(npm install -g omniroute)",
      "Bash(omniroute)",
      "Bash(omniroute --version)",
      "Bash(omniroute launch *)",
      "Bash(omniroute setup-claude *)",
      "Bash(headroom --version)",
      "Bash(headroom mcp install)",
      "Bash(headroom update)",
      "Bash(claude plugin marketplace add *)",
      "Bash(claude plugin install *)",
      "Bash(npx claude-mem install *)"
    ]
  }
}
