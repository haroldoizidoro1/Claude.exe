{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "one-skill-to-rule-them-all": {
      "source": {
        "source": "github",
        "repo": "rebelytics/one-skill-to-rule-them-all"
      }
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "task-observer@one-skill-to-rule-them-all": true
  },
  "permissions": {
    "allow": [
      "Bash(npm install -g omniroute)",
      "Bash(omniroute)",
      "Bash(omniroute --version)",
      "Bash(omniroute launch *)",
      "Bash(omniroute setup-claude *)",
      "Bash(claude plugin marketplace add *)",
      "Bash(claude plugin install *)"
    ]
  }
}
